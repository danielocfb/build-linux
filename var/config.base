# Minimal x86-64 kernel configuration sufficient for booting the result
# under vmsh (https://github.com/d-e-s-o/vmsh): KVM guest support, virtio
# MMIO transport, virtio-console for stdio forwarding, and FUSE/virtiofs
# for access to the host's file system.
#
# The action layers this on top of `allnoconfig` (via KCONFIG_ALLCONFIG),
# so anything not mentioned here stays disabled and builds stay fast.

# Core.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_KALLSYMS=y
CONFIG_SYSVIPC=y
CONFIG_SYSFS_SYSCALL=y

# Namespaces.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# x86 platform.
CONFIG_X86_X2APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_MTRR=y
CONFIG_HZ_300=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PM=y
CONFIG_ACPI=y
CONFIG_CPU_IDLE=y
CONFIG_HPET=y

# KVM guest support.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y

# Binary formats.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ELFCORE=y
CONFIG_COREDUMP=y

# Modules. Required for the `modules` input to have anything to install.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Networking. Only needed for CONFIG_DUMMY (see var/config.modules) and
# UNIX domain sockets.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y

# Drivers.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PCI=y
CONFIG_STANDALONE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Console.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEVMEM=y
CONFIG_DEVPORT=y

# virtio.
CONFIG_VIRTUALIZATION=y
CONFIG_VIRT_DRIVERS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y

# File systems. FUSE and virtiofs are what vmsh uses to expose the host's
# file system to the guest.
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Misc.
CONFIG_SYMBOLIC_ERRNAME=y
